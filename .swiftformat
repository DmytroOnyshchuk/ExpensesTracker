--swiftversion 5.10
--allman false
--binarygrouping 4,8
--closingparen balanced
--commas always
--comments indent
--decimalgrouping none
--elseposition same-line
--empty void
--exponentcase lowercase
--exponentgrouping disabled
--fractiongrouping disabled
--header ignore
--hexgrouping 4,8
--hexliteralcase uppercase
--ifdef indent
--importgrouping alphabetized
--indent 4
--indentcase false
--linebreaks lf
--octalgrouping 4,8
--operatorfunc spaced
--patternlet inline
--ranges spaced
--self init-only
--semicolons inline
--stripunusedargs closure-only
--trimwhitespace nonblank-lines
--wraparguments preserve
--wrapcollections preserve
--ifdef no-indent
--extensionacl on-declarations
--disable andOperator, redundantParens, strongOutlets, hoistPatternLet, opaqueGenericParameters, enumNamespaces, specifiers, wrapMultilineStatementBraces, modifierorder, preferKeyPath, preferForLoop, redundanttype
--exclude Libraries, Pods, ProvisionProfiles, swiftgen, fastlane, **/Generated, **/*.generated.swift
